<?xml version="1.0" encoding="utf-8" ?>
<data locale="ja">
	<!-- このコンテンツをお楽しみいただくためには、ポケモングローバルリンク上でゲームシンクIDコードを登録してください。 -->
	<string id="pg_amb_1" size="15" color="0x000000" kerning="true" letterSpacing="1" bold="true" />
	<!-- ゲームシンクIDコードは「ポケットモンスターブラック・ホワイト」で冒険をすすめてCギアを受け取った後、初めてゲームシンクする際に発行されます。	Cギアの「Wi-Fi」から「ゲームシンク」をタッチして進めてください。発行されたゲームシンクIDコードは「プロフィールページ」→「プロフィール設定」→「ゲームシンクIDコードの登録」より登録することができます。登録はポケモンを寝かしつけた状態で行ってください。 -->
	<string id="pg_amb_2" size="11" color="0x666666" kerning="true" letterSpacing="1" />
	<!-- とじる -->
	<string id="pg_amb_3" size="14" color="0xFFFFFF" kerning="true" letterSpacing="1" />
	<!-- 登録する -->
	<string id="pg_amb_4" size="14" color="0xFFFFFF" kerning="true" letterSpacing="1" />
	
	
	<!-- ポケモンがまだ夢をみていないようです。 ポケモンを寝かしつけていない場合は、ゲームシンクをしてポケモンを寝かしつけてください。すでにゲームシンクをしてポケモンを寝かしつけている場合は、ポケモングローバルリンクで夢をみるまで、時間がかかる場合があります。夢の世界で遊べるようになるまで、ポケモンを起こさず、しばらく時間を置いてから、再度アクセスをお試しください。-->
	<string id="pg_amd_1" size="14" color="0x000000" kerning="true" letterSpacing="1" />
	<!-- とじる -->
	<string id="pg_amd_2" size="14" color="0xFFFFFF" kerning="true" letterSpacing="1" />
	
	
	<!-- 前回つれて行こうとしたポケモン、または送ろうとした道具をソフトで受け取っていません。ねかしつけているポケモンを、下記のボタンより起こし、ゲームシンクをして、ポケモンや道具を受け取ってください。 -->
	<string id="pg_amc_1" size="16" color="0x000000" kerning="true" letterSpacing="1" />
	<!-- とじる -->
	<string id="pg_amc_2" size="14" color="0xFFFFFF" kerning="true" letterSpacing="1" />
	<!-- ポケモンを起こす -->
	<string id="pg_amc_3" size="14" color="0xFFFFFF" kerning="true" letterSpacing="1" />
	
	
	<!-- ポケモンを起こしました。 -->
	<string id="pg_amk_1" size="16" color="0x000000" kerning="true" letterSpacing="1" bold="true" />
	<!-- あと[MM1]分以内であれば、再度ポケモンドリームワールドにアクセスし、[MM2]分遊んでいただくことができます。 -->
	<string id="pg_amk_2" size="12" color="0x000000" kerning="true" letterSpacing="1" bold="true" />
	<!-- ※混雑状況によっては、上記時間でもアクセスできない場合がございます。※上記時間にアクセスがなかった場合、次回のアクセスは、23時間後から受付いたします。 -->
	<string id="pg_amk_3" size="11" color="0x666666" kerning="true" letterSpacing="1" />
	<!-- とじる -->
	<string id="pg_amk_4" size="14" color="0xFFFFFF" kerning="true" letterSpacing="1" />
	
	
	<!-- ポケモンドリームワールドへようこそ！ -->
	<string id="pg_amh_1" size="16" color="0x000000" kerning="true" letterSpacing="1" bold="true" />
	<!-- ポケモンドリームワールドで今回プレイいただける時間は只今より1時間です。 -->
	<string id="pg_amh_2" size="12" color="0x323232" kerning="true" letterSpacing="1" bold="true" />
	<!-- ※1時間以上経過しますと、自動的にポケモンドリームワールドが終了しますのでご注意ください。※自動的に終了する場合、その際プレイ中のデータがうまく保存されない可能性がございます。1時間経過時のアナウンスでポケモンドリームワールドを終了してください。 -->
	<string id="pg_amh_3" size="11" color="0x666666" kerning="true" letterSpacing="1" />
	<!-- とじる -->
	<string id="pg_amh_4" size="14" color="0xFFFFFF" kerning="true" letterSpacing="1" />
	
	
	<!-- ポケモンドリームワールドをご利用いただく場合には、あらかじめポケモンをねかしてからポケモングローバルリンクにログインしてください。 -->
	<!-- ポケモンドリームワールドは現在、非常に混雑しております。申し訳ございませんが、しばらく経ってから再度アクセスしてください。 -->
	<string id="pg_ade_1" size="16" color="0x000000" kerning="true" letterSpacing="1" bold="true" />
	<!-- ※ねかしつけているポケモンは下記のボタンより起こすことができます。 -->
	<string id="pg_ade_3" size="12" color="0x666666" kerning="true" letterSpacing="1" />
	<!-- とじる -->
	<string id="pg_ade_4" size="14" color="0xFFFFFF" kerning="true" letterSpacing="1" />
	<!-- ポケモンを起こす -->
	<string id="pg_ade_5" size="14" color="0xFFFFFF" kerning="true" letterSpacing="1" />
	
	
	<!-- 前回のアクセス時間は[MM]月[DD]日 [HH1]時です。	次回は、[HH2]時間後から受付いたします。 -->
	<!-- 前回のアクセス時間は[MM]月[DD]日 [HH1]時です。	次回は、[HH2]分後から受付いたします。 -->
	<!-- 前回のアクセス時間は[MM]月[DD]日 [HH1]時です。	次回は、1分以内から受付いたします。 -->
	<string id="pg_adi_1" size="16" color="0x000000" kerning="true" letterSpacing="1" bold="true" />
	<!-- ※混雑状況によっては、受付時間でもアクセスできない場合がございます。その場合は申し訳ございませんが、しばらく経ってから再度お試しください。 -->
	<!-- ※ねかしつけているポケモンは下記のボタンより起こすことができます。 -->
	<string id="pg_adi_4" size="12" color="0x666666" kerning="true" letterSpacing="1" />
	<!-- とじる -->
	<string id="pg_adi_6" size="14" color="0xFFFFFF" kerning="true" letterSpacing="1" />
	<!-- ポケモンを起こす -->
	<string id="pg_adi_7" size="14" color="0xFFFFFF" kerning="true" letterSpacing="1" />
</data>