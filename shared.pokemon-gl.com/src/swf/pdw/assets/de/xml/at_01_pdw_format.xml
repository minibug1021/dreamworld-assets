<string id="y_aa_18" size="12" bold="true" >Trauminsel „Frostige Höhle“</string>
<string id="y_ad_22" size="12" bold="true">[ポケモン名] möchte auf dem Eis spielen.</string>
<string id="y_ad_23" size="12" bold="true">Mit [ポケモン名] auf dem Eis spielen?</string>
<string id="y_ag_16" size="12" bold="true">Konfektjagd fehlgeschlagen.</string>
<string id="y_ag_17" size="12" bold="true">Konfektjagd abgebrochen.</string>
<string id="y_zc_6" size="12" bold="true">Auf der Trauminsel angekommen. Du nimmst den Weg durch die Frostige Höhle.</string>
<string id="y_aa_19" size="12" bold="true">Trauminsel „Traumpark“</string>
<string id="y_ad_24" size="12" bold="true">[ポケモン名] möchte auf dem See spielen.</string>
